{
  "name": "nanocode-vault",
  "main": "src/vault/index.ts",
  "compatibility_date": "2026-10-16",
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{ "name": "CREDENTIALS", "class_name": "CredentialVault" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CredentialVault"] }],
  "vars": {
    "ACCOUNT_ID": "default",
    "REFRESH_MARGIN_MS": "60000"
  },
  "observability": { "enabled": true }
}
