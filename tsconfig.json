{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "types": ["@cloudflare/workers-types"],
    "lib": ["ES2022", "ESNext.Disposable"],
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "worker/**/*.ts"]
}
