{
  "name": "nanocode-cloudflare-durable",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-ui.mjs && npm run check",
    "check": "tsc --noEmit && tsc --project tsconfig.ui.json",
    "dev": "wrangler dev",
    "dry-run": "wrangler deploy --dry-run --outdir output/deploy",
    "deploy": "wrangler deploy",
    "deploy:demo": "CLOUDFLARE_ACCOUNT_ID=0a39052b0a32ba8c8444345fe21b7595 wrangler deploy --name nanocode-cloudflare-durable --var CHAT_PUBLIC:1 --var CLAUDE_MODEL:claude-haiku-5-5 --var AI_GATEWAY_ID:nanocode-cloudflare-durable --var WORKERS_AI_ACCOUNT_ID:0a39052b0a32ba8c8444345fe21b7595 --var OPENAI_SERVICE_TIER:priority",
    "measure": "node scripts/measure-local.mjs",
    "drill": "node scripts/drill.mjs"
  },
  "dependencies": {
    "@pierre/highlights": "0.2.0",
    "nanocode-ts": "github:gakonst/nanocode-ts#840628deca880b5507bc8e67a838615ffe842d74",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zyzz": "0.0.40"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261016.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "typescript": "6.0.2",
    "wrangler": "4.151.1"
  }
}
