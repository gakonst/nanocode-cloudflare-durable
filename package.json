{
  "name": "nanocode-cloudflare-durable",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "check": "tsc --noEmit",
    "dev": "wrangler dev",
    "dry-run": "wrangler deploy --dry-run --outdir output/deploy",
    "deploy": "wrangler deploy",
    "deploy:demo": "wrangler deploy --name nanocode-cloudflare-durable --var CHAT_PUBLIC:1 --var CLAUDE_MODEL:claude-haiku-5-5",
    "measure": "node scripts/measure-local.mjs",
    "drill": "node scripts/drill.mjs"
  },
  "dependencies": {
    "nanocode-ts": "github:gakonst/nanocode-ts#4cdd87b00dab1534932d0db179ffe07344eab072"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261016.1",
    "typescript": "6.0.2",
    "wrangler": "4.151.1"
  },
  "exports": {
    ".": "./src/index.ts"
  }
}
