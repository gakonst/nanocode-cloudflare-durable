{
  "name": "nanocode-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "dev": "wrangler dev -c wrangler.jsonc -c wrangler.egress.jsonc",
    "deploy": "node scripts/deploy.mjs",
    "dry-run": "wrangler deploy -c wrangler.egress.jsonc --dry-run --outdir output/egress && wrangler deploy -c wrangler.jsonc --dry-run --outdir output/deploy",
    "measure": "node scripts/measure-local.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261016.1",
    "typescript": "6.0.2",
    "wrangler": "4.151.1"
  }
}
