{
  "name": "nanocode-egress",
  "main": "src/egress/index.ts",
  "compatibility_date": "2026-10-16",
  "workers_dev": false,
  "preview_urls": false,
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AccountAuthority"] },
    { "tag": "v2", "deleted_classes": ["AccountAuthority"] }
  ],
  "services": [
    { "binding": "VAULT", "service": "nanocode-vault", "entrypoint": "CredentialBroker" }
  ],
  "vpc_services": [
    { "binding": "RUNNER_VPC_PARADIGM_A", "service_id": "01a14e2c-a47e-7160-90dc-146bb38585ea" },
    { "binding": "RUNNER_VPC_PARADIGM_B", "service_id": "01a14e2c-a87a-7a93-9ac6-34a506f79763" },
    { "binding": "CODEX_TRANSPORT", "service_id": "01a14e3b-e285-75e2-ad52-a736b9255c25" }
  ],
  "vars": {
    "ACCOUNT_ID": "default",
    "CREDENTIAL_CACHE_TTL_MS": "600000",
    "REFRESH_MARGIN_MS": "60000",
    "MODEL_RESPONSE_HEADERS_TIMEOUT_MS": "120000",
    "MODEL_STREAM_IDLE_TIMEOUT_MS": "120000",
    "RUNNERS_JSON": "[{\"id\":\"paradigm-a\",\"url\":\"http://127.0.0.1:19081/\",\"binding\":\"RUNNER_VPC_PARADIGM_A\"},{\"id\":\"paradigm-b\",\"url\":\"http://127.0.0.1:19082/\",\"binding\":\"RUNNER_VPC_PARADIGM_B\"}]"
  },
  "observability": { "enabled": true }
}
