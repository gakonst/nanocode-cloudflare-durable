{
  "name": "nanocode-egress",
  "main": "src/egress/index.ts",
  "compatibility_date": "2026-10-16",
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{ "name": "ACCOUNTS", "class_name": "AccountAuthority" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AccountAuthority"] }],
  "services": [{ "binding": "SESSION_FENCES", "service": "nanocode-worker", "entrypoint": "SessionControl" }],
  "vpc_services": [
    { "binding": "RUNNER_VPC_PARADIGM_A", "service_id": "01a14e2c-a47e-7160-90dc-146bb38585ea" },
    { "binding": "RUNNER_VPC_PARADIGM_B", "service_id": "01a14e2c-a87a-7a93-9ac6-34a506f79763" }
  ],
  "vars": {
    "ACCOUNT_ID": "default",
    "CREDENTIAL_CACHE_TTL_MS": "600000",
    "REFRESH_MARGIN_MS": "60000",
    "CONNECT_TOKEN_TTL_MS": "3600000",
    "CONNECT_REFRESH_TTL_MS": "2592000000",
    "CONNECT_CODE_TTL_MS": "300000",
    "RECOVERY_DELAY_MS": "30000"
  },
  "observability": { "enabled": true }
}
