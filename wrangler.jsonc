{
  "name": "nanocode",
  "main": "worker/index.ts",
  "workers_dev": true,
  "compatibility_date": "2026-10-16",
  "minify": true,
  "assets": { "binding": "ASSETS", "directory": "./public" },
  "build": { "command": "node scripts/build-ui.mjs" },
  "ai": { "binding": "AI" },
  "kv_namespaces": [{ "binding": "MCP_LISTINGS_KV" }],
  "ratelimits": [{ "name": "PUBLIC_RATE", "namespace_id": "4203", "simple": { "limit": 30, "period": 60 } }],
  "containers": [{ "class_name": "RelayContainer", "image": "./node_modules/nanocode-ts/node_modules/nanocode-egress/relay.Dockerfile", "instance_type": "lite", "max_instances": 2 }],
  "durable_objects": {
    "bindings": [
      { "name": "SESSIONS", "class_name": "AgentSession" },
      { "name": "HAND_RELAYS", "class_name": "HandRelay" },
      { "name": "PUBLIC_LIMITS", "class_name": "PublicLimit" },
      { "name": "MCP_LISTINGS", "class_name": "McpListings" },
      { "name": "PYTHON", "class_name": "Pyodide", "script_name": "nanocode-python" },
      { "name": "WALLETS", "class_name": "Wallet" },
      { "name": "PLANS", "class_name": "PlanVault" },
      { "name": "RELAY", "class_name": "RelayContainer" },
      { "name": "SESSION_POOL", "class_name": "SessionPool" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AgentSession"] },
    { "tag": "v2", "new_sqlite_classes": ["PublicLimit"] },
    { "tag": "v3", "new_sqlite_classes": ["HandRelay"] },
    { "tag": "v4", "new_sqlite_classes": ["Wallet"] },
    { "tag": "v5", "new_sqlite_classes": ["Python"], "deleted_classes": ["HandRelay"] },
    { "tag": "v6", "new_sqlite_classes": ["HandRelay"] },
    { "tag": "v7", "new_sqlite_classes": ["McpListings"] },
    { "tag": "v8", "new_sqlite_classes": ["PlanVault", "RelayContainer"] },
    { "tag": "v9", "new_sqlite_classes": ["SessionPool"] }
  ],
  "vars": {
    "AI_GATEWAY_ID": "default",
    "OPENAI_SERVICE_TIER": "",
    "ACCESS_TOKEN_SHA256": "",
    "CHAT_PUBLIC": "",
    "MODEL_AUTH": "api_key",
    "WORKERS_AI_ACCOUNT_ID": "",
    "RECOVERY_DELAY_MS": "5000",
    "RECOVERY_BACKOFF_MS": "3600000",
    "EVENT_STREAM_KEEPALIVE_MS": "5000",
    "EVENT_PAGE_SIZE": "128",
    "EVENT_TAIL_BYTES": "4194304",
    "EVENT_COALESCE_MS": "100",
    "MODEL_SOCKET_LINGER_MS": "30000",
    "MODEL_PRIME_IDLE_MS": "15000",
    "MCP_LISTING_CACHE_TTL_S": "86400",
    "RUNTIME_MEMORY_BUDGET_BYTES": "67108864",
    "REMOTE_MAX_FRAME_BYTES": "1048576",
    "REMOTE_TIMEOUT_MS": "30000",
    "SESSION_POOL_CACHED_NAMES": "10000",
    "SESSION_POOL_KEEPALIVE_MS": "30000",
    "SESSION_POOL_SIZE": "4"
  },
  "observability": { "enabled": true }
}
