{
  "name": "nanocode-worker",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-16",
  "build": {
    "command": "npm run build",
    "watch_dir": ["src", "Cargo.toml", "Cargo.lock", "scripts/build.mjs", "../nanocodex/crates", "../nanocodex/Cargo.toml", "../nanocodex/Cargo.lock"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "SESSIONS", "class_name": "AgentSession" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AgentSession", "SubscriptionAuth"] }
  ],
  "services": [
    { "binding": "EGRESS", "service": "nanocode-egress", "entrypoint": "SessionEgress" }
  ],
  "vars": {
    "ACCOUNT_ID": "default",
    "WORKER_TOKEN_SHA256": "1074ee1870ae6c08005081e2c0bc88ec9d2efca2a977c4e8c5b1306a6c302df8",
    "SESSION_LOCATION_HINT": "enam",
    "MODEL_AUTH": "subscription",
    "RECOVERY_DELAY_MS": "30000",
    "EVENT_STREAM_KEEPALIVE_MS": "5000",
    "EVENT_PAGE_SIZE": "128",
    "EVENT_COALESCE_MS": "100",
    "MODEL_SOCKET_LINGER_MS": "30000",
    "RUNTIME_MEMORY_BUDGET_BYTES": "67108864",
    "RUNNER_ENABLED": "false",
    "REMOTE_MAX_FRAME_BYTES": "1048576",
    "REMOTE_TIMEOUT_MS": "30000"
  },
  "observability": { "enabled": true }
}
