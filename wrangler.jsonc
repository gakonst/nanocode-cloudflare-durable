{
  "name": "nanocode",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-16",
  "assets": { "directory": "./public" },
  "ai": { "binding": "AI" },
  "ratelimits": [{ "name": "PUBLIC_LIMIT", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }],
  "durable_objects": {
    "bindings": [
      { "name": "SESSIONS", "class_name": "AgentSession" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AgentSession"] }
  ],
  "vars": {
    "AI_GATEWAY_ID": "default",
    "ACCESS_TOKEN_SHA256": "",
    "CHAT_PUBLIC": "",
    "MODEL_AUTH": "api_key",
    "RECOVERY_DELAY_MS": "5000",
    "EVENT_STREAM_KEEPALIVE_MS": "5000",
    "EVENT_PAGE_SIZE": "128",
    "EVENT_TAIL_BYTES": "4194304",
    "EVENT_COALESCE_MS": "100",
    "MODEL_SOCKET_LINGER_MS": "30000",
    "RUNTIME_MEMORY_BUDGET_BYTES": "67108864",
    "REMOTE_MAX_FRAME_BYTES": "1048576",
    "REMOTE_TIMEOUT_MS": "30000"
  },
  "observability": { "enabled": true }
}
